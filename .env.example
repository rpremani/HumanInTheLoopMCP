# Human-in-the-Loop MCP Server — Environment Variables
# Copy this file to .env and fill in the values for the tools you use.
# All variables are optional — only configure what you need.

# ============================================================
# GitHub
# ============================================================
# Personal access token with repo, workflow, and PR scopes
GITHUB_TOKEN=

# Override GitHub API base URL (for GitHub Enterprise)
# GITHUB_API_URL=https://api.github.com

# ============================================================
# Harness CI/CD
# ============================================================
HARNESS_API_KEY=
HARNESS_ACCOUNT_ID=
HARNESS_ORG_ID=
HARNESS_PROJECT_ID=
HARNESS_PIPELINE_ID=

# Override defaults only if using a self-hosted Harness instance
# HARNESS_API_URL=https://app.harness.io
# HARNESS_UI_BASE_URL=https://app.harness.io

# ============================================================
# OpenShift
# ============================================================
OPENSHIFT_API_URL=
OPENSHIFT_CONSOLE_URL=
OPENSHIFT_USERNAME=
OPENSHIFT_PASSWORD=

# Token-based auth (alternative to username/password)
# OPENSHIFT_TOKEN=

# Run browser-based login in headless mode (true/false, default: true)
# OPENSHIFT_HEADLESS=true

# ============================================================
# Splunk
# ============================================================
SPLUNK_URL=

# Token-based auth (recommended)
SPLUNK_TOKEN=

# Basic auth (alternative to token)
# SPLUNK_USERNAME=
# SPLUNK_PASSWORD=

# ============================================================
# Network / Proxy
# ============================================================
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
